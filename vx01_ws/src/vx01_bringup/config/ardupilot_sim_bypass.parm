# VX-01 Simulation ArduPilot Parameter Overrides
# Applied AFTER the standard defaults to bypass pre-arm checks
# that always fail when drone is mounted on/near the hexapod body.

# Disable ALL pre-arm checks (bitmask=0 = no checks)
ARMING_CHECK 0

# Disable EKF failsafe (stops disarming on EKF unhealthy during hex motion)
FS_EKF_ACTION 0

# Disable compass use entirely (Gazebo compass field is unreliable)
COMPASS_USE  0
COMPASS_USE2 0
COMPASS_USE3 0

# Relax EKF thresholds for sim
EK3_CHECK_SCALE 200

# Allow arming even when GPS HDOP is high
GPS_HDOP_GOOD 2.3

# GPS type for SITL JSON model  
GPS_TYPE 1
GPS_TYPE2 0

# Rangefinder: use SIM type (no serial port needed in Gazebo)
# Without this, ArduPilot tries SERIAL and fails, broadcasting
# DISTANCE_SENSOR messages MAVROS can't map → ERROR spam → TCP overload
RNGFND1_TYPE 17
RNGFND1_ORIENT 25
RNGFND1_MIN_CM 20
RNGFND1_MAX_CM 1200

# Reduce MAVLink stream rates to prevent buffer overload.
# SR0 = SERIAL0 (TCP 5760), SR1 = SERIAL1 (UDP 14550)
SR0_EXTRA1   4
SR0_EXTRA2   4
SR0_EXTRA3   2
SR0_EXT_STAT 4
SR0_POSITION 4
SR0_RAW_SENS 2
SR0_RC_CHAN  2
SR0_ADSB     0

SR1_EXTRA1   4
SR1_EXTRA2   4
SR1_EXTRA3   2
SR1_EXT_STAT 4
SR1_POSITION 4
SR1_RAW_SENS 2
SR1_RC_CHAN  2
SR1_ADSB     0

# Allow fast arming + pilot speed in sim
PILOT_SPEED_UP 500
