<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="imu_link">
        <inertial>
            <origin xyz="-4.9599E-19 -9.0896E-20 0.005" rpy="0 0 0"/>
            <mass value="0.0045937"/>
            <inertia
                ixx="1.9002E-07" ixy="1.1915E-23" ixz="5.4526E-24"
                iyy="2.7817E-07" iyz="-4.039E-25"
                izz="3.9603E-07"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://vx01_description/meshes/sensors/imu_link.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.79216 0.81961 0.93333 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://vx01_description/meshes/sensors/imu_link.STL"/>
            </geometry>
        </collision>
    </link>

    <joint name="imu_joint" type="fixed">
        <origin xyz="-0.0013383 0 0.0025" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child  link="imu_link"/>
        <axis xyz="0 0 0"/>
    </joint>

    <xacro:if value="${use_sim}">
        <gazebo reference="imu_link">
            <sensor name="imu_sensor" type="imu">
                <ignition_frame_id>imu_link</ignition_frame_id>
                <always_on>1</always_on>
                <update_rate>100</update_rate>
                <visualize>false</visualize>
                <imu>
                    <enable_orientation>1</enable_orientation>
                    <angular_velocity>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.000855</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>0.0</dynamic_bias_stddev><dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time><precision>0.001065</precision></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.000855</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>0.0</dynamic_bias_stddev><dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time><precision>0.001065</precision></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.000855</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>0.0</dynamic_bias_stddev><dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time><precision>0.001065</precision></noise></z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.007358</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>0.0</dynamic_bias_stddev><dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time><precision>0.004905</precision></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.007358</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>0.0</dynamic_bias_stddev><dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time><precision>0.004905</precision></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.007358</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>0.0</dynamic_bias_stddev><dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time><precision>0.004905</precision></noise></z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>
    </xacro:if>

</robot>