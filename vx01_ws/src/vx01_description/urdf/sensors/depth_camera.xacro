<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="depth_camera_link">
        <inertial>
            <origin xyz="-0.0098321 -0.0010768 1.0105E-09" rpy="0 0 0"/>
            <mass value="0.031591"/>
            <inertia
                ixx="1.8776E-05" ixy="1.8867E-07" ixz="2.3396E-13"
                iyy="2.0987E-06" iyz="-7.3767E-13"
                izz="1.9046E-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://vx01_description/meshes/sensors/depth_camera_link.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.79216 0.81961 0.93333 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://vx01_description/meshes/sensors/depth_camera_link.STL"/>
            </geometry>
        </collision>
    </link>

    <link name="depth_camera_optical_frame"/>

    <joint name="depth_camera_joint" type="fixed">
        <origin xyz="0.10899 0.002292 0.1135" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child  link="depth_camera_link"/>
        <axis xyz="0 0 0"/>
    </joint>

    <joint name="depth_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
        <parent link="depth_camera_link"/>
        <child  link="depth_camera_optical_frame"/>
    </joint>

    <xacro:if value="${use_sim}">
        <gazebo reference="depth_camera_link">
            <sensor name="depth_camera" type="rgbd_camera">
                <ignition_frame_id>depth_camera_optical_frame</ignition_frame_id>
                <camera name="depth_camera">
                    <horizontal_fov>1.2878</horizontal_fov>
                    <lens>
                        <intrinsics>
                            <fx>549.6</fx>
                            <fy>548.7</fy>
                            <cx>320.8</cx>
                            <cy>239.4</cy>
                            <s>0</s>
                        </intrinsics>
                    </lens>
                    <distortion>
                        <k1>0.0</k1><k2>0.0</k2><k3>0.0</k3>
                        <p1>0.0</p1><p2>0.0</p2>
                        <center>0.5 0.5</center>
                    </distortion>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip><near>0.1</near><far>10.0</far></clip>
                    <depth_camera>
                        <clip><near>0.2</near><far>4.0</far></clip>
                    </depth_camera>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.002</stddev>
                    </noise>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>0</visualize>
                <topic>depth_camera</topic>
            </sensor>
        </gazebo>
    </xacro:if>

</robot>