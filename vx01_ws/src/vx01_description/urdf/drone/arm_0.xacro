<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="arm_link_0">
        <inertial>
            <origin
                xyz="0.0063327 -0.00071305 0.16079"
                rpy="0 0 0" />
            <mass
                value="0.079293" />
            <inertia
                ixx="0.00030547"
                ixy="3.5362E-08"
                ixz="-1.1722E-05"
                iyy="0.00030691"
                iyz="8.9793E-07"
                izz="8.3071E-06" />
        </inertial>

        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="package://vx01_description/meshes/drone/arm_link_0.STL" />
            </geometry>
            <material
                name="">
                <color
                    rgba="0.25098 0.25098 0.25098 1" />
            </material>
        </visual>

        <collision>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="package://vx01_description/meshes/drone/arm_link_0.STL" />
            </geometry>
        </collision>
    </link>

    <joint name="arm_joint0" type="revolute">
        <origin
            xyz="0.02791 -0.027041 0.115"
            rpy="1.5708 0 0.785398" />
        <parent
            link="base_link" />
        <child
            link="arm_link_0" />
        <axis
            xyz="0 0 -1" />
        <limit
            lower="-1.57"
            upper="1.57"
            effort="1.5"
            velocity="3.14" />
    </joint>

    <link name="motor_link_0">
        <inertial>
            <origin
                xyz="-0.00086646 -4.4318E-06 0.01301"
                rpy="0 0 0" />
            <mass
                value="0.013155" />
            <inertia
                ixx="8.3905E-07"
                ixy="1.2379E-13"
                ixz="-2.9714E-09"
                iyy="8.6253E-07"
                iyz="-7.3924E-14"
                izz="1.2626E-06" />
        </inertial>
        
        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="package://vx01_description/meshes/drone/motor_link_0.STL" />
            </geometry>
            <material
                name="">
                <color
                    rgba="0.95686 0.95686 0.95686 1" />
            </material>
        </visual>

        <collision>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="package://vx01_description/meshes/drone/motor_link_0.STL" />
            </geometry>
        </collision>
    </link>

    <joint name="motor_0" type="fixed">
        <origin
            xyz="0.010724 0 0.27229"
            rpy="-1.5708 -1.5314 0" />
        <parent
            link="arm_link_0" />
        <child
            link="motor_link_0" />
        <axis
            xyz="0 0 0" />
    </joint>

    <link name="prop_link_0">
        <inertial>
            <mass
                value="0.005" />
            <inertia
                ixx="0.0001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0001"
                iyz="0.0"
                izz="0.0001" />
        </inertial>

        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="package://vx01_description/meshes/drone/prop_link_0.STL" />
            </geometry>
            <material
                name="">
                <color
                    rgba="0.29412 0.29412 0.29412 1" />
            </material>
        </visual>

        <!-- Removed collision mesh for propeller to prevent physics instability (ODE Error) -->
    </link>

    <joint name="prop_0" type="continuous">
        <origin
            xyz="0 0 0.0402"
            rpy="0 0 1.5708" />
        <parent
            link="motor_link_0" />
        <child
            link="prop_link_0" />
        <axis
            xyz="0 0 1" />
        <limit effort="100.0" velocity="2000.0" />
    </joint>

</robot>