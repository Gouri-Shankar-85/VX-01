<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="vx01_ros2_control" params="
    use_sim:=true
    serial_port:=/dev/ttyACM1
    baud_rate:=115200
    pwm_frequency:=50
    gpio_chip:=gpiochip0
    max_interpolation_step:=0.02">

    <xacro:if value="${use_sim}">

        <ros2_control name="vx01_hardware" type="system">

            <hardware>
                <plugin>ign_ros2_control/IgnitionSystem</plugin>
            </hardware>

            <!-- ── Hexapod legs (18 joints) ── -->

            <joint name="coxa_leg0_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg0_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg0_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.60</param></state_interface>
            </joint>

            <joint name="coxa_leg1_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg1_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg1_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.60</param></state_interface>
            </joint>

            <joint name="coxa_leg2_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg2_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg2_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.60</param></state_interface>
            </joint>

            <joint name="coxa_leg3_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg3_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg3_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.60</param></state_interface>
            </joint>

            <joint name="coxa_leg4_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg4_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg4_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.60</param></state_interface>
            </joint>

            <joint name="coxa_leg5_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg5_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg5_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.60</param></state_interface>
            </joint>

            <!-- ── Drone arms (4 joints) ── -->

            <joint name="arm_joint0">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="arm_joint1">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="arm_joint2">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="arm_joint3">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>

            <joint name="prop_0">
                <command_interface name="velocity"></command_interface>
                <state_interface name="velocity"></state_interface>
                <state_interface name="position"></state_interface>
            </joint>
            <joint name="prop_1">
                <command_interface name="velocity"></command_interface>
                <state_interface name="velocity"></state_interface>
                <state_interface name="position"></state_interface>
            </joint>
            <joint name="prop_2">
                <command_interface name="velocity"></command_interface>
                <state_interface name="velocity"></state_interface>
                <state_interface name="position"></state_interface>
            </joint>
            <joint name="prop_3">
                <command_interface name="velocity"></command_interface>
                <state_interface name="velocity"></state_interface>
                <state_interface name="position"></state_interface>
            </joint>

        </ros2_control>

    </xacro:if>

    <xacro:unless value="${use_sim}">

        <ros2_control name="vx01_hexapod_hardware" type="system">
            <hardware>
                <plugin>vx01_hexapod_hardware/HexapodHardwareInterface</plugin>
                <param name="serial_port">${serial_port}</param>
                <param name="baud_rate">${baud_rate}</param>
                <param name="max_interpolation_step">${max_interpolation_step}</param>
            </hardware>
            <joint name="coxa_leg0_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg0_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg0_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.6</param></state_interface>
            </joint>
            <joint name="coxa_leg1_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg1_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg1_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.6</param></state_interface>
            </joint>
            <joint name="coxa_leg2_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg2_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg2_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.6</param></state_interface>
            </joint>
            <joint name="coxa_leg3_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg3_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg3_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.6</param></state_interface>
            </joint>
            <joint name="coxa_leg4_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg4_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg4_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.6</param></state_interface>
            </joint>
            <joint name="coxa_leg5_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
            </joint>
            <joint name="femur_leg5_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">-0.785</param></state_interface>
            </joint>
            <joint name="tibia_leg5_joint">
                <command_interface name="position"><param name="min">-1.5708</param><param name="max">1.5708</param></command_interface>
                <state_interface name="position"><param name="initial_value">0.6</param></state_interface>
            </joint>
        </ros2_control>

    </xacro:unless>

</xacro:macro>

</robot>