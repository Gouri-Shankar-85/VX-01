# =============================================================================
# VX-01 Dockerfile.base
# Hardware image — runs on both AMD64 (laptop) and ARM64 (Raspberry Pi 5)
#
# KEY CHANGE: Base is now ubuntu:22.04 explicitly.
# The RDK X5 had Ubuntu 22.04 natively so the FROM wasn't needed before.
# Raspberry Pi 5 ships with Ubuntu 24.04 — ROS2 Humble does NOT support 24.04,
# so we pin the container to Ubuntu 22.04 regardless of what the host runs.
# Docker containers are isolated from the host OS, so this works fine.
# =============================================================================

FROM ubuntu:22.04

# ── Prevent apt from asking interactive questions ────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Kolkata

# ── Basic system packages ────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg2 \
    lsb-release \
    ca-certificates \
    locales \
    software-properties-common \
    sudo \
    git \
    wget \
    unzip \
    build-essential \
    cmake \
    python3-pip \
    python3-setuptools \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    udev \
    libusb-1.0-0-dev \
    libudev-dev \
    libhidapi-dev \
    v4l-utils \
    i2c-tools \
    && rm -rf /var/lib/apt/lists/*

# ── Locale (ROS2 requires UTF-8) ─────────────────────────────────────────────
RUN locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# ── Add ROS2 Humble apt repository ──────────────────────────────────────────
# ROS2 Humble officially supports Ubuntu 22.04 (Jammy). This is why the FROM
# must be ubuntu:22.04. On Ubuntu 24.04 there is no Humble apt repo.
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list

# ── Install ROS2 Humble Desktop + common robotics packages ──────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-desktop \
    ros-humble-ros-base \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-cv-bridge \
    ros-humble-image-transport \
    ros-humble-image-transport-plugins \
    ros-humble-sensor-msgs \
    ros-humble-geometry-msgs \
    ros-humble-nav-msgs \
    ros-humble-tf2 \
    ros-humble-tf2-ros \
    ros-humble-tf2-tools \
    ros-humble-xacro \
    ros-humble-robot-state-publisher \
    ros-humble-joint-state-publisher \
    ros-humble-diagnostic-updater \
    ros-humble-teleop-twist-keyboard \
    && rm -rf /var/lib/apt/lists/*

# ── MAVROS + ArduPilot support ───────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-mavros \
    ros-humble-mavros-extras \
    && rm -rf /var/lib/apt/lists/*

# Download GeographicLib datasets (needed by MAVROS — do it here so it's
# cached in the image and never needs to be done manually)
RUN wget -q https://raw.githubusercontent.com/mavlink/mavros/master/mavros/scripts/install_geographiclib_datasets.sh \
        -O /tmp/install_geo.sh && \
    chmod +x /tmp/install_geo.sh && \
    /tmp/install_geo.sh && \
    rm /tmp/install_geo.sh

# ── Navigation + SLAM ────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-nav2-bringup \
    ros-humble-nav2-map-server \
    ros-humble-nav2-amcl \
    ros-humble-rtabmap-ros \
    && rm -rf /var/lib/apt/lists/*

# ── HP60C Depth Camera (UVC, no proprietary SDK) ────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-libuvc-camera \
    libopenni2-dev \
    ros-humble-openni2-camera \
    && rm -rf /var/lib/apt/lists/*

# ── Pololu Mini Maestro library (built from source) ─────────────────────────
# Works on both AMD64 and ARM64 — pure C with no arch-specific asm.
RUN git clone --depth 1 https://github.com/pololu/pololu-usb-sdk.git /tmp/pololu-usb-sdk && \
    cd /tmp/pololu-usb-sdk/Maestro/UscCmd && \
    make && \
    cp UscCmd /usr/local/bin/maestro-cmd && \
    cd / && rm -rf /tmp/pololu-usb-sdk

# Python binding for Maestro HID
RUN pip3 install --no-cache-dir pyserial hidapi

# ── rosdep init ─────────────────────────────────────────────────────────────
RUN rosdep init 2>/dev/null || true && \
    rosdep update --rosdistro humble

# ── Create the ROS2 workspace ────────────────────────────────────────────────
RUN mkdir -p /vx01_ws/src
WORKDIR /vx01_ws

# ── Source ROS2 automatically in every shell ─────────────────────────────────
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc && \
    echo "[ -f /vx01_ws/install/setup.bash ] && source /vx01_ws/install/setup.bash" >> /root/.bashrc

# ── Copy entrypoint ──────────────────────────────────────────────────────────
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]